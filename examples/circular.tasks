# this example loads colorado network without any attributes
network.count()

# let's make nodes small so we can see the edges
nodes.visual.nodesize = 1

# the code below calculates position for each node in a circular layout
total = net.count()
max_ord = max(nodes.ORDER, -inf)
nodes do {
    x = sin(pi() * 2 * INDEX / total) * (max_ord - ORDER);
    y = cos(pi() * 2 * INDEX / total) * (max_ord - ORDER);
    node.set_xy(x, y)
}

# it is similar to circular_layout, circular layout function uses
# weight instead, and does a log transform
network.circular_layout(log=false)

# as an exercise you can try to modify the code above to replicate
# the circular_layout position 

network.circular_layout()

# a different approach to circular layout, not as pretty
nodes.outord = ORDER # needs this because there are bifurcations
nodes<out>.outord = if (len(outputs._) == 0) {ORDER} else {max(outputs.outord, 1) - 1}

total = net.count()
max_ord = max(nodes.ORDER, -inf)
nodes do {
    x = sin(pi() * 2 * INDEX / total) * (max_ord - outord);
    y = cos(pi() * 2 * INDEX / total) * (max_ord - outord);
    node.set_xy(x, y)
}

# in case someone runs Refresh All
network.circular_layout()

